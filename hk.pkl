amends "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Builtins.pkl"

exclude = List("submodules/**")

steps {
  ["detect_private_key"] = Builtins.detect_private_key
  ["check_merge_conflict"] = Builtins.check_merge_conflict
  ["check_symlinks"] = Builtins.check_symlinks
  ["check_executables_have_shebangs"] = Builtins.check_executables_have_shebangs

  // shell
  ["shellcheck"] = (Builtins.shellcheck) {
    env { ["SHELLCHECK_OPTS"] = "--external-sources --source-path=SCRIPTDIR" }
  }

  // zsh
  ["zsh"] {
    glob = "zsh/*.zsh"
    check = "for f in {{files}}; do zsh -n \"$f\"; done"
  }

  // toml
  ["taplo"] = Builtins.taplo
  ["taplo_format"] = Builtins.taplo_format
  ["mise"] = Builtins.mise

  // yaml
  ["yq"] = Builtins.yq

  // json
  ["jq"] = (Builtins.jq) {
    exclude =
      List(
        "macos/Alfred.alfredpreferences/**",
        "agents/claude/settings.json",
        "**/lazy-lock.json",
      )
  }

  // git config
  ["gitconfig"] {
    glob = List("git/gitconfig*", "git/*.gitconfig")
    check = "for f in {{files}}; do git config -f \"$f\" --list >/dev/null; done"
  }

  // tmux
  ["tmux"] {
    glob = "tmux/tmux.conf"
    check = "tmux -L hk-lint -f tmux/tmux.conf start-server \\; kill-server"
  }

  // brewfile
  ["brewfile"] {
    glob = "macos/Brewfile"
    check = "brew bundle check -q --no-upgrade --file=macos/Brewfile"
  }

  // lua
  ["stylua"] = (Builtins.stylua) {
    types = null
    glob = "**/*.lua"
  }
  ["selene"] = (Builtins.selene) {
    types = null
    glob = "neovim/**/*.lua"
    workspace_indicator = "selene.toml"
    dir = "{{workspace}}"
  }

  // pkl
  ["pkl_format"] = Builtins.pkl_format

  // hk
  ["hk"] {
    glob = "hk.pkl"
    check = "hk --quiet validate"
  }

  // plist
  ["plist"] {
    glob = "**/*.plist"
    batch = true
    check = "plutil -lint -s {{files}}"
  }

  // ghostty
  ["ghostty"] {
    glob = "ghostty/config.ghostty"
    check =
      #"""
      app=$(brew info --cask --json=v2 ghostty | jq -r '.casks[0].artifacts[] | select(.app) | .target')
      "$app/Contents/MacOS/ghostty" +validate-config --config-file=ghostty/config.ghostty
      """#
  }

  // ssh
  ["ssh"] {
    glob = List("ssh/config", "ssh/personal", "ssh/work")
    check = "ssh -T -G -F ssh/config localhost >/dev/null"
  }

  // markdown
  ["rumdl_format"] = Builtins.rumdl_format
  ["rumdl"] = (Builtins.rumdl) {
    depends = "rumdl_format"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = outer.steps
  }
  ["pre-push"] { steps = outer.steps }
}
