amends "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Builtins.pkl"

exclude = List("submodules/**")

steps {
  // repo hygiene
  ["detect_private_key"] = Builtins.detect_private_key
  ["check_merge_conflict"] = Builtins.check_merge_conflict
  ["check_symlinks"] = Builtins.check_symlinks
  ["check_executables_have_shebangs"] = Builtins.check_executables_have_shebangs

  // shell
  ["shellcheck"] = (Builtins.shellcheck) {
    // hk batches files, so follow `source`d files that are not in the batch
    env { ["SHELLCHECK_OPTS"] = "-x" }
  }

  // zsh
  ["zsh"] {
    glob = "zsh/*.zsh"
    check = "for f in {{files}}; do zsh -n \"$f\"; done"
  }

  // toml
  ["taplo"] = Builtins.taplo
  ["taplo_format"] = (Builtins.taplo_format) {
    // vendored astrodark themes stay byte-identical to upstream
    exclude = List("helix/themes/**", "wezterm/colors/**")
  }
  ["mise"] = Builtins.mise

  // yaml
  ["yq"] = Builtins.yq

  // json
  ["jq"] = (Builtins.jq) {
    // Alfred writes its own json
    exclude = "macos/Alfred.alfredpreferences/**"
  }

  // git config
  ["gitconfig"] {
    glob = List("git/gitconfig*", "git/*.gitconfig")
    check = "for f in {{files}}; do git config -f \"$f\" --list >/dev/null; done"
  }

  // tmux
  ["tmux"] {
    glob = "tmux/tmux.conf"
    check = "tmux -L hk-lint -f tmux/tmux.conf start-server \\; kill-server"
  }

  // brewfile
  ["brewfile"] {
    glob = "macos/Brewfile"
    check = "brew bundle check --no-upgrade --file=macos/Brewfile >/dev/null"
  }

  // lua
  ["stylua"] = (Builtins.stylua) {
    types = null
    glob = "**/*.lua"
  }
  // one run per neovim config, each with its own selene.toml
  ["selene"] = (Builtins.selene) {
    types = null
    glob = "neovim/**/*.lua"
    workspace_indicator = "selene.toml"
    dir = "{{workspace}}"
  }

  // pkl
  ["hk"] {
    glob = "hk.pkl"
    check = "hk validate"
  }
  ["pkl_format"] = Builtins.pkl_format

  // plist
  ["plist"] {
    glob = "**/*.plist"
    batch = true
    check = "plutil -lint -s {{files}}"
  }

  // ghostty
  ["ghostty"] {
    glob = "ghostty/config.ghostty"
    check =
      #"""
      app=$(brew info --cask --json=v2 ghostty | jq -r '.casks[0].artifacts[] | select(.app) | .target')
      "$app/Contents/MacOS/ghostty" +validate-config --config-file=ghostty/config.ghostty
      """#
  }

  // ssh
  ["ssh"] {
    glob = List("ssh/config", "ssh/personal", "ssh/work")
    check = "ssh -G -F ssh/config localhost >/dev/null"
  }

  // markdown
  ["rumdl_format"] = Builtins.rumdl_format
  ["rumdl"] = (Builtins.rumdl) {
    depends = "rumdl_format"
  }
}

// top-level steps already create the check, fix and pre-commit hooks
hooks {
  ["pre-push"] { steps = outer.steps }
}
