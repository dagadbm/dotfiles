{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 36500,
  "env": {
    "CAVEMAN_DEFAULT_MODE": "ultracave",
    "PONYTAIL_DEFAULT_MODE": "full",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "ENABLE_TOOL_SEARCH": "auto",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787/w/claude",
    "_CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(grep:*)",
      "Bash(tr:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(source:*)",
      "Bash(tree:*)",
      "Bash(git:*)",
      "Bash(curl:*)",
      "Bash(gt:*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.ssh/id_*)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.ppk)",
      "Read(**/*.gpg)",
      "Read(**/*.pgp)",
      "Read(**/*.asc)",
      "Read(**/.aws/credentials)",
      "Read(**/.azure/**)",
      "Read(**/.config/gcloud/**)",
      "Read(**/.kube/config)",
      "Read(**/*vault_pass*)",
      "Read(**/secrets.yml)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.json)",
      "Read(**/credentials.json)",
      "Read(**/.htpasswd)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/application.properties)",
      "Read(**/appsettings.json)",
      "Read(**/*.tfstate)",
      "Read(**/.git/config)",
      "Read(**/.git-credentials)",
      "Read(**/.bash_history)",
      "Read(**/.zsh_history)",
      "Read(**/.pgpass)",
      "Read(**/.my.cnf)",
      "Read(**/.docker/config.json)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Bash(sudo:*)",
      "Read(**/.ssh/**)",
      "Edit(**/.ssh/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(curl -X POST:*)",
      "Bash(curl -X PUT:*)",
      "Bash(curl -X DELETE:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "haiku",
  "disableBundledSkills": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/scripts/bash-validator-hook.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node' '/Users/dagadbm/.local/share/mise/installs/npm-caveman-ai-cli/latest/bin/caveman' shrink-hook"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/npm-caveman-ai-cli/4.0.1/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/dagadbm/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/npm-caveman-ai-cli/4.0.1/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/npm-caveman-ai-cli/4.0.1/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/npm-caveman-ai-cli/4.0.1/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/npm-caveman-ai-cli/4.0.1/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/npm-caveman-ai-cli/4.0.1/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/npm-caveman-ai-cli/4.0.1/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/npm-caveman-ai-cli/4.0.1/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/npm-caveman-ai-cli/4.0.1/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/npm-caveman-ai-cli/4.0.1/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 1
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "cowork-plugin-management@synced": false,
    "mattpocock-skills@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "potetos-for-everyone": {
      "source": {
        "source": "github",
        "repo": "TheOnlyFusionCube/potetos-for-everyone"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": false,
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "low",
      "autoCompactWindow": 250000
    },
    "claude-haiku-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 250000
    },
    "claude-opus-5-5": {
      "effortLevel": "low",
      "autoCompactWindow": 250000
    },
    "claude-sonnet-5-5": {
      "effortLevel": "low",
      "autoCompactWindow": 250000
    }
  },
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "preferredNotifChannel": "auto",
  "idleCompaction": true,
  "autoContinueAtUsageLimit": false,
  "agentPushNotifEnabled": false
}
