{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_BUG_COMMAND": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787/w/claude",
    "_CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL": "1",
    "ENABLE_TOOL_SEARCH": "auto",
    "CAVEMAN_DEFAULT_MODE": "ultracave"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(grep:*)",
      "Bash(tr:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(source:*)",
      "Bash(tree:*)",
      "Bash(git:*)",
      "Bash(curl:*)",
      "Bash(gt:*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.ssh/id_*)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.ppk)",
      "Read(**/*.gpg)",
      "Read(**/*.pgp)",
      "Read(**/*.asc)",
      "Read(**/.aws/credentials)",
      "Read(**/.azure/**)",
      "Read(**/.config/gcloud/**)",
      "Read(**/.kube/config)",
      "Read(**/*vault_pass*)",
      "Read(**/secrets.yml)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.json)",
      "Read(**/credentials.json)",
      "Read(**/.htpasswd)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/application.properties)",
      "Read(**/appsettings.json)",
      "Read(**/*.tfstate)",
      "Read(**/.git/config)",
      "Read(**/.git-credentials)",
      "Read(**/.bash_history)",
      "Read(**/.zsh_history)",
      "Read(**/.pgpass)",
      "Read(**/.my.cnf)",
      "Read(**/.docker/config.json)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)"
    ]
  },
  "disableBundledSkills": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/scripts/bash-validator-hook.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/dagadbm/.local/share/caveman-blocks/bin/caveman-blocks hook --harness claude",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node' '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/caveman' shrink-hook",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/node/lts/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/node/lts/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/dagadbm/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/node/lts/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/node/lts/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/node/lts/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/node/lts/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/node/lts/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/node/lts/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/node/lts/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dagadbm/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/dagadbm/.local/share/mise/installs/node/lts/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/dagadbm/.local/share/mise/installs/node/lts/bin/node'",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 1
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "agent-skills@addy-agent-skills": true,
    "mattpocock-skills@claude-plugins-official": true,
    "pstack@potetos-for-everyone": true,
    "superpowers@claude-plugins-official": true,
    "cowork-plugin-management@synced": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "potetos-for-everyone": {
      "source": {
        "source": "github",
        "repo": "TheOnlyFusionCube/potetos-for-everyone"
      }
    },
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": false,
  "modelSettings": {
    "claude-fable-5-1": {
      "autoCompactWindow": 300000
    },
    "claude-opus-5-5": {
      "autoCompactWindow": 300000
    },
    "claude-haiku-5-5": {
      "autoCompactWindow": 300000
    },
    "claude-sonnet-5-5": {
      "autoCompactWindow": 300000
    }
  },
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "preferredNotifChannel": "auto",
  "autoContinueAtUsageLimit": false,
  "agentPushNotifEnabled": false
}
