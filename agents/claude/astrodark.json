{
  "//": [
    "astrodark theme, derived",
    "legend: <palette key> (<derivation or taken from X>, optional): <variables set>",
    "ui.accent: briefLabelClaude, claude, claudeBlue_FOR_SYSTEM_SPINNER, professionalBlue, rate_limit_fill, suggestion",
    "syntax.text: text",
    "ui.text: inactiveShimmer",
    "ui.base: composerSidebarBackground, inverseText",
    "syntax.comment: inactive",
    "syntax.mute: promptBorderShimmer, subtle",
    "ui.border: promptBorder, rate_limit_empty",
    "ui.prompt: bashMessageBackgroundColor, memoryBackgroundColor, userMessageBackground",
    "ui.highlight: userMessageBackgroundHover",
    "ui.selection: selectionBg",
    "ui.red: error",
    "ui.orange: bashBorder",
    "ui.yellow: chromeYellow, fastMode, warning",
    "ui.green: autoAccept, briefLabelYou, success",
    "ui.cyan: background, ide",
    "ui.purple: effortUltra, merged, permission, planMode, remember, skill",
    "syntax.red: rainbow_red, red_FOR_SUBAGENTS_ONLY",
    "syntax.orange: orange_FOR_SUBAGENTS_ONLY, rainbow_orange",
    "syntax.yellow: fastModeShimmer, rainbow_orange_shimmer, rainbow_yellow, warningShimmer, yellow_FOR_SUBAGENTS_ONLY",
    "syntax.green: autoAcceptShimmer, green_FOR_SUBAGENTS_ONLY, rainbow_green",
    "syntax.cyan: cyan_FOR_SUBAGENTS_ONLY, rainbow_blue",
    "syntax.blue: blue_FOR_SUBAGENTS_ONLY, claudeBlueShimmer_FOR_SYSTEM_SPINNER, claudeShimmer, rainbow_indigo",
    "syntax.purple: permissionShimmer, purple_FOR_SUBAGENTS_ONLY, rainbow_violet",
    "term.bright_red: pink_FOR_SUBAGENTS_ONLY, rainbow_red_shimmer",
    "term.bright_yellow: rainbow_yellow_shimmer",
    "term.bright_green: rainbow_green_shimmer",
    "term.bright_cyan: rainbow_blue_shimmer",
    "term.bright_blue: rainbow_indigo_shimmer",
    "term.bright_purple: rainbow_violet_shimmer",
    "none (Claude orange, dark preset default): clawd_body",
    "syntax.green (blend 0.75 into ui.base, taken from delta plus-style): diffAdded",
    "syntax.red (blend 0.75 into ui.base, taken from delta minus-style): diffRemoved",
    "syntax.green (blend 0.85 into ui.base): diffAddedDimmed",
    "syntax.red (blend 0.85 into ui.base): diffRemovedDimmed",
    "syntax.green (blend 0.75 then 0.45 into ui.base, taken from delta plus-emph-style): diffAddedWord",
    "syntax.red (blend 0.75 then 0.45 into ui.base, taken from delta minus-emph-style): diffRemovedWord",
    "notes: base dark, not dark-ansi: the ansi diff renderer draws unreadable grey line backgrounds; dark gives Monokai Extended code colours in diffs (not customisable), so every other token is set here"
  ],
  "base": "dark",
  "name": "astrodark",
