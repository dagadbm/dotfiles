#!/usr/bin/env bash
set -euo pipefail

# The prompt sources, one per line (the forms are in
# scripts/sources.sh): prompts_test_sources (the settings' test), else the
# ones saved from the ⌘⇧. settings, else the workflow configuration's Plugins
# field, else these defaults
source "$(dirname "$0")/sources.sh"

if [[ -n "${prompts_test_sources:-}" ]]; then
  printf '%s\n' "$prompts_test_sources"
elif [[ -s "$data/plugins" ]]; then
  cat "$data/plugins"
elif [[ -n "${prompts_plugins:-}" ]]; then
  printf '%s\n' "$prompts_plugins"
else
  cat <<'DEFAULTS'
claude anthropics/claude-plugins-official mattpocock-skills
claude anthropics/claude-plugins-official superpowers
claude addyosmani/agent-skills agent-skills
claude forrestchang/andrej-karpathy-skills
claude anthropics/skills example-skills
claude anthropics/skills document-skills
claude vercel-labs/agent-skills
DEFAULTS
fi
