#!/usr/bin/env bash
# settings-lookup <source>, run async: a source line, or a bare repo or link,
# as typed source lines to pick with a double-click: a Claude marketplace's
# plugins, else the repo as a Claude plugin and as Markdown files
source "$(dirname "$0")/sources.sh"
_parse "$1"
case "$type" in
  claude | markdown) ;;
  *)
    _repo "$1"
    type=""
    ;;
esac
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

_say() {
  printf note >"$data/pane"
  _pane "$(_pane_note "$1")"
}

if [[ "$repo" == /* ]]; then
  printf '[]' >"$data/found.json"
  _say "A local folder needs no lookup: add \`markdown $repo\` to the list."
  exit
fi
if [[ -z "$repo" || "$repo" != */* ]]; then
  printf '[]' >"$data/found.json"
  _say "Not a GitHub repo: \`$1\`"
  exit
fi
if ! _clone "https://github.com/$repo.git" "$tmp/repo" "$ref" 2>/dev/null; then
  printf '[]' >"$data/found.json"
  _say "Could not get \`$repo\`${ref:+ at \`$ref\`}: no such public GitHub repo or branch."
  exit
fi
marketplace="$tmp/repo/.claude-plugin/marketplace.json"
at="$repo${ref:+@$ref}"
if [[ -n "$type" ]]; then
  # a typed line, as is
  jq -n --arg line "$1" --arg name "${plugin:-${path:-$repo}}" '[{line: $line, name: $name, description: "Double-click to add or remove"}]' \
    >"$tmp/rows.json"
elif [[ -z "$path" && -f "$marketplace" ]]; then
  jq --arg at "$at" '[.plugins[] | {line: "claude \($at) \(.name)", name: .name, description: (.description // "")}]' \
    "$marketplace" >"$tmp/rows.json"
else
  jq -n --arg at "$at" --arg path "$path" '[
    (if $path == "" then {line: "claude \($at)", name: "\($at) as a Claude plugin", description: "Its skills/<name>/SKILL.md"} else empty end),
    {line: ("markdown \($at)" + (if $path == "" then "" else " \($path)" end)), name: "\($at)\(if $path == "" then "" else "/\($path)" end) as Markdown", description: "Every .md and .mdc file, add a glob to pick some"}
  ]' >"$tmp/rows.json"
fi
cp "$tmp/rows.json" "$data/found.json"
scripts/settings-toggle
