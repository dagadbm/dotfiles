# astrodark theme, derived
# legend: <palette key>: <variables set>
# ui.statusline: COLOR_BAR
# ui.accent: COLOR_ACCENT, BATTERY_BLUE
# ui.base: COLOR_ACCENT_TEXT
# ui.selection: COLOR_SEGMENT
# ui.text_inactive: COLOR_INACTIVE
# ui.yellow: PROMPT_FILL, BATTERY_YELLOW_DARK
# syntax.green: BATTERY_GREEN
# ui.green: BATTERY_GREEN_DARK
# syntax.yellow: BATTERY_YELLOW
# syntax.orange: BATTERY_ORANGE
# ui.orange: BATTERY_ORANGE_DARK
# syntax.red: BATTERY_RED
# ui.red: BATTERY_RED_DARK
# ui.text: BATTERY_GREY
%hidden COLOR_BAR="#111317"
%hidden COLOR_ACCENT="#50A4E9"
%hidden COLOR_ACCENT_TEXT="#1A1D23"
%hidden COLOR_SEGMENT="#26343F"
%hidden COLOR_INACTIVE="#494D56"
%hidden PROMPT_FILL="#D09214"
%hidden BATTERY_GREEN="#87C05F"
%hidden BATTERY_GREEN_DARK="#75AD47"
%hidden BATTERY_YELLOW="#DFAB25"
%hidden BATTERY_YELLOW_DARK="#D09214"
%hidden BATTERY_ORANGE="#F5983A"
%hidden BATTERY_ORANGE_DARK="#EB8332"
%hidden BATTERY_RED="#FF838B"
%hidden BATTERY_RED_DARK="#F8747E"
%hidden BATTERY_BLUE="#50A4E9"
%hidden BATTERY_GREY="#9B9FA9"
