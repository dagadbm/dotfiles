# astrodark colours, from the astrotheme palette
# astrodark theme, derived
# legend: <palette key>: <roles>
# ui.statusline: bar (COLOR_BAR)
# ui.accent: accent (COLOR_ACCENT), battery attached (BATTERY_BLUE)
# ui.base: text on accent (COLOR_ACCENT_TEXT)
# ui.selection: segments (COLOR_SEGMENT)
# ui.text_inactive: inactive windows (COLOR_INACTIVE)
# ui.yellow: prefix/copy prompt fill (PROMPT_FILL), battery tier 5 (BATTERY_YELLOW_DARK)
# syntax.green: battery tier 8, charged, charging (BATTERY_GREEN)
# ui.green: battery tier 7 (BATTERY_GREEN_DARK)
# syntax.yellow: battery tier 6, discharging (BATTERY_YELLOW)
# syntax.orange: battery tier 4 (BATTERY_ORANGE)
# ui.orange: battery tier 3 (BATTERY_ORANGE_DARK)
# syntax.red: battery tier 2 (BATTERY_RED)
# ui.red: battery tier 1 (BATTERY_RED_DARK)
# ui.text: battery unknown (BATTERY_GREY)
%hidden COLOR_BAR="#111317"
%hidden COLOR_ACCENT="#50A4E9"
%hidden COLOR_ACCENT_TEXT="#1A1D23"
%hidden COLOR_SEGMENT="#26343F"
%hidden COLOR_INACTIVE="#494D56"
%hidden PROMPT_FILL="#D09214"
%hidden BATTERY_GREEN="#87C05F"
%hidden BATTERY_GREEN_DARK="#75AD47"
%hidden BATTERY_YELLOW="#DFAB25"
%hidden BATTERY_YELLOW_DARK="#D09214"
%hidden BATTERY_ORANGE="#F5983A"
%hidden BATTERY_ORANGE_DARK="#EB8332"
%hidden BATTERY_RED="#FF838B"
%hidden BATTERY_RED_DARK="#F8747E"
%hidden BATTERY_BLUE="#50A4E9"
%hidden BATTERY_GREY="#9B9FA9"
